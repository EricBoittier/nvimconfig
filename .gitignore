# Machine-specific lua_ls workspace config (contains absolute $HOME paths)
.luarc.json
lua/.luarc.json

# Vendored vim packages: plugins are managed by lazy.nvim instead
pack/

# Local overrides, not shared between machines
lua/slydragonn/local.lua

# Personal to-dos shown on the start screen (see plugins/alpha.lua)
reminders.md

# Editor / OS noise
*.swp
*.swo
.DS_Store
spell/

# Third-party theme collection, cloned separately (see README)
kitty/kitty-themes/

# Machine-local base theme (symlink into kitty-themes on this box)
kitty/theme.conf

# kitty runtime state written by kitty/kmode
kitty/.kmode
kitty/current-theme.conf
kitty/*-theme.auto.conf
kitty/*.bak
