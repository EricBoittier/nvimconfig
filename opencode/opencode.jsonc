{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "queuekie": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Queuekie Monster",
      "options": {
        "baseURL": "https://inference-api.hpc.epfl.ch/v1",
        "apiKey": "{env:QUEUEKIE_API_KEY}"
      },
      "models": {
        "zai-org/GLM-5.3": {
          "name": "GLM-5.3",
          "limit": { "context": 1048576, "output": 32768 }
        },
        "zai-org/GLM-5.3-Flash": {
          "name": "GLM-5.3 Flash",
          "limit": { "context": 262144, "output": 32768 }
        }
      }
    }
  }
}
